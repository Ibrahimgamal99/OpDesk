# OpDesk backend configuration.
#
# Native installs: install.sh writes backend/.env (mode 600) from these names and keeps your values
# on re-run. Docker: copy this file to .env next to docker-compose.yml.
# With network_mode: host, 127.0.0.1 reaches MariaDB and AMI on the PBX host, as natively.

OS=debian
# FreePBX | Issabel | Generic: picks the reload command (fwconsole / amportal) and config file names.
PBX=FreePBX

# --- Databases: the PBX config (asterisk), its CDR (asteriskcdrdb) and OpDesk's own (OpDesk) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=OpDesk
DB_PASSWORD=change_me
DB_NAME=asterisk
DB_CDR=asteriskcdrdb
DB_OpDesk=OpDesk

# --- Asterisk ---
# Fallback only: Settings > Recording (RECORDING_ROOT_DIR) takes precedence.
ASTERISK_RECORDING_ROOT_DIR=/var/spool/asterisk/monitor/
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=OpDesk
AMI_SECRET=change_me
AMI_CONTEXT=ext-local

# --- HTTP ---
# The backend (Node.js) listens on OPDESK_BIND_HOST:PORT, plain HTTP; nginx terminates TLS.
PORT=8765
OPDESK_BIND_HOST=127.0.0.1
# Used only when HTTPS_CERT/HTTPS_KEY are set (the backend then serves TLS itself on this port).
OPDESK_HTTPS_PORT=8443
# Public HTTPS port nginx serves OpDesk on (the installer sets it). Added to the URLs the backend
# hands out, e.g. the softphone's wss://<host>:<port>/sip-ws, when it is not 443.
NGINX_HTTPS_PORT=443
OPDESK_DOMAIN=opdesk.example.com
CORS_ALLOWED_ORIGINS=https://opdesk.example.com,https://192.0.2.10
# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
# Leave empty behind nginx.
HTTPS_CERT=
HTTPS_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Python interpreter of the voice-activity analysis venv (backend/vad). Empty = analysis off.
# The Docker image sets it itself.
VAD_PYTHON=/opt/OpDesk/backend/vad/.venv/bin/python

# --- Mobile push notifications (optional) ---
# Leave these unset to disable push (the web client is unaffected). A provider is skipped unless
# all of its vars are present. Mount the key files as secrets; never commit them.
# (Docker: the compose file mounts ./secrets at /opt/opdesk/secrets.)
# Android: Firebase Cloud Messaging (HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/opt/OpDesk/secrets/fcm-service-account.json
# iOS: direct APNs (HTTP/2, token-based auth). The VoIP topic is <APNS_BUNDLE_ID>.voip
APNS_AUTH_KEY_FILE=/opt/OpDesk/secrets/AuthKey_XXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=false
# Settings > Mobile Wake overrides these. Hold time (8-30 s): longest a call waits for the phone
# to wake and re-register; settle window (0-10 s): extra wait after it.
MOBILE_WAKE_WAIT=10
MOBILE_WAKE_SETTLE=3

# --- Optional ---
# Sets the admin password on every start while set (plain text; prefer changing it in the UI).
# OPDESK_ADMIN_PASSWORD=
# Listen on this port instead of PORT, e.g. for a second instance beside the live one.
# OPDESK_LISTEN_PORT=8766
# Watch-only mode for such a second instance: read-only AMI, no Asterisk config writes or
# reloads, no recording deletes. Point DB_OpDesk at a copy of the database: the app DB is written.
# OPDESK_SHADOW=1

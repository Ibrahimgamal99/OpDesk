{
  "name": "asterisk-operator-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:errors": "eslint src --quiet",
    "lint:css": "stylelint \"src/styles/*.css\"",
